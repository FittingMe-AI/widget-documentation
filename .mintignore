# Mintlify automatically ignores these files and directories:
# .git, .github, .claude, .agents, .idea, node_modules,
# README.md, LICENSE.md, CHANGELOG.md, CONTRIBUTING.md

# Draft content
drafts/
*.draft.mdx

# Local worktrees and operating-system metadata
.worktrees/
.DS_Store

# Local verification, tools and unpublished implementation provenance
.review/
scripts/
package.json
package-lock.json

# Repository guidance is not retailer documentation
AGENTS.md
CLAUDE.md
