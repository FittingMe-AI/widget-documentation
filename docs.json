{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "luma",
  "name": "FittingMe.ai",
  "colors": {
    "primary": "#b4ad91",
    "light": "#e4e1d6",
    "dark": "#9a9377"
  },
  "fonts": {
    "heading": {
      "family": "Outfit"
    },
    "body": {
      "family": "Outfit"
    }
  },
  "styling": {
