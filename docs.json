{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "luma",
  "name": "FittingMe.ai",
  "colors": {
    "primary": "#b4ad91",
    "light": "#e4e1d6",
    "dark": "#9a9377"
  },
  "fonts": {
    "heading": { "family": "Playfair Display" },
    "body": { "family": "Outfit" }
  },
  "styling": {
    "codeblocks": { "theme": "vesper" }
  },
  "appearance": {
    "default": "light"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      { "label": "Contact", "href": "https://fittingme.ai/contact/" }
    ]
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "introduction",
              "quickstart"
            ]
          },
          {
            "group": "Integration",
            "pages": [
              "guides/widget-keys",
              "guides/integration",
              "guides/managing-multiple-widgets",
              "guides/troubleshooting"
