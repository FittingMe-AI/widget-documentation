{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "luma",
  "name": "FittingMe.ai",
  "colors": {
    "primary": "#b4ad91",
    "light": "#e4e1d6",
    "dark": "#9a9377"
  },
  "fonts": {
    "heading": {
      "family": "Outfit"
    },
    "body": {
      "family": "Outfit"
    }
  },
  "styling": {
    "codeblocks": {
      "theme": "vesper"
    }
  },
  "appearance": {
    "default": "light"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Contact",
        "href": "/troubleshooting/support"
      }
    ]
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "introduction",
              "start/prerequisites",
              "start/quickstart"
            ]
          },
          {
            "group": "Integration guides",
            "pages": [
              "integration/products",
              "integration/product-changes",
              "integration/react",
              "integration/appearance",
              "integration/analytics",
              "integration/direct-embed"
            ]
          },
          {
            "group": "Test and launch",
            "pages": [
              "testing/journey",
              "testing/security",
              "testing/launch"
            ]
          },
          {
            "group": "Troubleshooting",
            "pages": [
              "troubleshooting/symptoms",
              "troubleshooting/support"
            ]
          },
          {
            "group": "Technical reference",
            "pages": [
              "reference/configuration",
              "reference/javascript",
              "reference/events",
              "reference/errors",
              "reference/compatibility",
              "reference/protocol"
            ]
          },
          {
            "group": "Maintenance",
            "pages": [
              "maintenance/releases",
              "maintenance/updates"
            ]
          }
        ]
      }
    ]
  },
  "footer": {
    "socials": {}
  },
  "redirects": [
    {
      "source": "/quickstart",
      "destination": "/start/quickstart"
    },
    {
      "source": "/quickstarts/provided-button",
      "destination": "/start/quickstart"
    },
    {
      "source": "/quickstarts/custom-button",
      "destination": "/integration/appearance"
    },
    {
      "source": "/quickstarts/direct-protocol",
      "destination": "/integration/direct-embed"
    },
    {
      "source": "/start/access-keys-domains",
      "destination": "/start/prerequisites"
    },
    {
      "source": "/start/first-product",
      "destination": "/integration/products"
    },
    {
      "source": "/guides/product-changes",
      "destination": "/integration/product-changes"
    },
    {
      "source": "/guides/multiple-embeds",
      "destination": "/integration/product-changes"
    },
    {
      "source": "/guides/react-nextjs",
      "destination": "/integration/react"
    },
    {
      "source": "/guides/prepared-catalogue",
      "destination": "/integration/products"
    },
    {
      "source": "/reference/loader-api",
      "destination": "/reference/javascript"
    },
    {
      "source": "/reference/fittingme-3",
      "destination": "/reference/protocol"
    },
    {
      "source": "/tracking/usage",
      "destination": "/integration/analytics"
    },
    {
      "source": "/tracking/gtm-ga4",
      "destination": "/integration/analytics"
    },
    {
      "source": "/tracking/commerce",
      "destination": "/integration/analytics"
    },
    {
      "source": "/testing/go-live",
      "destination": "/testing/launch"
    },
    {
      "source": "/testing/troubleshooting",
      "destination": "/troubleshooting/symptoms"
    },
    {
      "source": "/guides/integration",
      "destination": "/start/prerequisites"
    }
  ]
}
