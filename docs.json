      "theme": "vesper"
    }
  },
  "appearance": {
    "default": "light"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Contact",
        "href": "https://fittingme.ai/contact/"
      }
    ]
  },
  "navigation": {
