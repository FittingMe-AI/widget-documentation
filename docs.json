            "pages": [
              "guides/product-changes",
              "guides/multiple-embeds",
              "guides/react-nextjs",
              "guides/prepared-catalogue"
            ]
          },
          {
            "group": "Reference",
            "pages": [
              "reference/configuration",
              "reference/loader-api",
              "reference/fittingme-3",
              "reference/events"
            ]
          },
          {
            "group": "Tracking",
            "pages": [
